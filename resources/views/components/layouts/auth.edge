{{--
  Rahmen für die Seiten Anmelden und Registrieren.
  Oben das Logo, darunter zwei Reiter, darunter das Formular der jeweiligen Seite.
--}}
<!DOCTYPE html>
<html lang="de" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Creativo</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>

  <body class="auth-page">
    <main class="auth-card">

      {{-- Logo --}}
      <p class="auth-logo">Creativo</p>

      {{-- Reiter: Anmelden / Registrieren --}}
      <nav class="auth-tabs" aria-label="Anmelden oder Registrieren">
        @navLink({ route: 'session.create', class: 'auth-tab' })
          Anmelden
        @end
        @navLink({ route: 'new_account.create', class: 'auth-tab' })
          Registrieren
        @end
      </nav>

      {{-- Hier wird das Formular der jeweiligen Seite eingesetzt --}}
      {{{ await $slots.main() }}}

    </main>

    @include('partials/flash_alerts')
  </body>
</html>