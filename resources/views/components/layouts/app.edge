{{--
  Hauptlayout von Creativo für alle Seiten nach dem Login.

  Aufbau:
  - Obere Leiste mit Logo und Abmelden
  - Seitenleiste mit Menü (nur Desktop)
  - Inhalt der jeweiligen Seite
  - Leiste unten mit Menü (nur Smartphone)

  Beide Menüs werden aus derselben Liste "nav" gebaut.
  Menüpunkte mit route: null haben noch keine Seite und sind noch nicht klickbar.
--}}

{{-- Liste aller Menüpunkte --}}
@let(nav = [
  { label: 'Startseite', route: 'dashboard', icon: 'lucide:house' },
  { label: 'Beitrag erstellen', route: null, icon: 'lucide:plus' },
  { label: 'Benachrichtigungen', route: null, icon: 'lucide:bell' },
  { label: 'Kalender', route: null, icon: 'lucide:calendar' },
  { label: 'Profil', route: null, icon: 'lucide:user' },
])

{{-- Titel, den die jeweilige Seite mitgibt --}}
@let(pageTitle = $props.get('title'))

<!DOCTYPE html>
<html lang="de" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle || 'Creativo' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>

  <body class="app">

    {{-- Obere Leiste: Logo links, Abmelden rechts --}}
    <header class="topbar">
      <a href="{{ urlFor('dashboard') }}" class="topbar__logo">Creativo</a>

      @form({ route: 'session.destroy', method: 'POST' })
        <button type="submit" class="btn btn--secondary btn--sm">
          @svg('lucide:log-out', { width: 15, height: 15 })
          Abmelden
        </button>
      @end
    </header>

    <div class="app-shell">

      {{-- Seitenleiste (nur Desktop) --}}
      <nav class="sidebar" aria-label="Hauptnavigation">
        @each(item in nav)
          @if(item.route)
            {{-- Seite existiert: echter Link --}}
            @navLink({ route: item.route, class: 'sidebar__item' })
              @svg(item.icon, { width: 20, height: 20 })
              <span>{{ item.label }}</span>
            @end
          @else
            {{-- Seite existiert noch nicht: nur anzeigen --}}
            <span class="sidebar__item is-disabled">
              @svg(item.icon, { width: 20, height: 20 })
              <span>{{ item.label }}</span>
            </span>
          @end
        @end
      </nav>

      {{-- Hier wird der Inhalt der jeweiligen Seite eingesetzt --}}
      <main class="page-content">
        {{{ await $slots.main() }}}
      </main>

    </div>

    {{-- Leiste unten (nur Smartphone) --}}
    <nav class="bottom-nav" aria-label="Hauptnavigation">
      @each(item in nav)
        @if(item.route)
          {{-- Seite existiert: echter Link --}}
          @navLink({ route: item.route, class: 'bottom-nav__item', 'aria-label': item.label })
            @svg(item.icon, { width: 24, height: 24 })
          @end
        @else
          {{-- Seite existiert noch nicht: nur anzeigen --}}
          <span class="bottom-nav__item is-disabled" aria-label="{{ item.label }}">
            @svg(item.icon, { width: 24, height: 24 })
          </span>
        @end
      @end
    </nav>

    {{-- Rückmeldungen wie "Erfolgreich gespeichert" (aus dem Starterkit) --}}
    @include('partials/flash_alerts')

  </body>
</html>