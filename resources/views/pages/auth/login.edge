@layouts.auth()
  <h1 class="auth-title">Willkommen zurück</h1>
  <p class="auth-sub">Melde dich an, um weiterzumachen.</p>

  @form({ route: 'session.store', method: 'POST', class: 'auth__form' })

    @field.root({ name: 'email' })
      @!field.label({ text: 'E-Mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'name@beispiel.de',
      })
      @!field.error()
    @end

    @field.root({ name: 'password' })
      @!field.label({ text: 'Passwort' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end

    @!button({ text: 'Anmelden', type: 'submit', block: true })

  @end
@end