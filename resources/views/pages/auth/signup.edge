@layouts.auth()
  <h1 class="auth-title">Konto erstellen</h1>
  <p class="auth-sub">Teile deine kreativen Projekte mit der Community.</p>

  @form({ route: 'new_account.store', method: 'POST', class: 'auth__form' })

    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Name' })
      @!input.control({ autocomplete: 'name', placeholder: 'Max Muster' })
      @!field.error()
    @end

    @field.root({ name: 'email' })
      @!field.label({ text: 'E-Mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'name@beispiel.de',
      })
      @!field.error()
    @end

    @field.root({ name: 'password' })
      @!field.label({ text: 'Passwort' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end

    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Passwort wiederholen' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end

    @!button({ text: 'Registrieren', type: 'submit', block: true })

  @end
@end